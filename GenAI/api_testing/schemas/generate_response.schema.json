{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Ollama Generate API Response",
    "description": "Response contract for POST /api/generate with stream=false",
    "type": "object",
    "required": [
        "model",
        "created_at",
        "response",
        "done",
        "total_duration"
    ],
    "properties": {
        "model": {
            "type": "string",
            "minLength": 1
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "response": {
            "type": "string"
        },
        "done": {
            "type": "boolean"
        },
        "done_reason": {
            "type": ["string", "null"]
        },
        "total_duration": {
            "type": "integer",
            "minimum": 0
        },
        "load_duration": {
            "type": "integer",
            "minimum": 0
        },
        "prompt_eval_count": {
            "type": "integer",
            "minimum": 0
        },
        "prompt_eval_duration": {
            "type": "integer",
            "minimum": 0
        },
        "eval_count": {
            "type": "integer",
            "minimum": 0
        },
        "eval_duration": {
            "type": "integer",
            "minimum": 0
        }
    },
    "additionalProperties": true
}